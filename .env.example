# ==========================================
# Raisequity Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Client-Side Public Configuration (Vite)
# Safe to bundle in client SPA bundle
# ------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_ADMIN_EMAIL=admin@yourdomain.com

# ------------------------------------------
# 2. Server-Side Private Secrets (Vercel Functions ONLY)
# CRITICAL: DO NOT add VITE_ prefix to these secrets.
# They are only accessed in api/*.ts serverless endpoints.
# ------------------------------------------
# Dodo Payments (Checkout & Subscriptions)
DODO_PAYMENTS_API_KEY=live_or_test_dodo_api_key
DODO_SUBSCRIPTION_PRODUCT_ID=pdt_subscription_product_id
DODO_PAYMENTS_ENV=test
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret

# Resend (Email Alerts & Weekly Digest Dispatch)
RESEND_API_KEY=re_live_or_test_resend_api_key
RESEND_FROM_EMAIL=intro@yourdomain.com

# OpenSign (Legally-Binding Facilitation Agreements)
OPENSIGN_API_KEY=live_or_test_opensign_api_key
OPENSIGN_TEMPLATE_ID=your_opensign_template_id
OPENSIGN_BASE_URL=https://api.opensignlabs.com/v1

# Google Gemini AI (Match Explanations & Deck Synthesis)
GEMINI_API_KEY=your_gemini_api_key

# Firebase Admin Service Account (for secure webhook activation)
FIREBASE_SERVICE_ACCOUNT_JSON=
